---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import LocalBusinessSchema from "@/components/LocalBusinessSchema.astro";

interface Props {
    title: string;
    description: string;
    canonicalPath?: string;
    socialImage?: string;
    socialImageAlt?: string;
}

const {
    title,
    description,
    canonicalPath = "/",
    socialImage = "/social-card.jpg",
    socialImageAlt = "Decoración de eventos realizada por Decorazon Joss",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(canonicalPath, Astro.site) : undefined;
const socialImageURL = Astro.site ? new URL(socialImage, Astro.site) : socialImage;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}

        <title>{title}</title>

        <!-- Open Graph: WhatsApp, Facebook and LinkedIn -->
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_CR" />
        <meta property="og:site_name" content="Decorazon Joss" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialImageAlt} />

        <!-- Twitter/X card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        <LocalBusinessSchema />

        <script is:inline>
            (() => {
                const savedTheme = localStorage.getItem("decorazon-theme");
                const preferredTheme = matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
                document.documentElement.dataset.theme = savedTheme || preferredTheme;
            })();
        </script>
    </head>
    <body>
        <Navbar />
        <main class="overflow-x-hidden w-full max-w-full"><slot /></main>
        <Footer />
    </body>
</html>
