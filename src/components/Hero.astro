---
import heroImage from "../assets/portada.webp";import inlineImage from "../assets/15.webp";import { ArrowRight } from "@phosphor-icons/react";
---
<section class="hero section-shell"><div class="hero-copy"><p class="eyebrow">Decoración de eventos en Costa Rica</p><h1>Haz cada celebración <span>inolvidable</span></h1><p class="hero-text">Transforma tus momentos especiales en recuerdos mágicos con nuestros servicios de decoración para eventos. Desde reuniones íntimas hasta celebraciones grandiosas, traemos tu visión a vida.</p><div class="hero-actions"><a class="button button-primary" href="#contact">Reserva <ArrowRight size={18}/></a><a class="button button-secondary" href="#creations">Ver decoraciones</a></div></div><div class="hero-visual"><div class="hero-arch"></div><img src={heroImage.src} alt="Decoración colorida para el primer cumpleaños de Lucía" fetchpriority="high" width={heroImage.width} height={heroImage.height}/><div class="inline-photo"><img src={inlineImage.src} alt="Detalle de una celebración decorada" loading="lazy" decoding="async" width={inlineImage.width} height={inlineImage.height}/></div></div></section>
<style>
.hero{min-height:clamp(720px,95vh,980px);padding-top:clamp(9rem,14vw,12rem);padding-bottom:clamp(5rem,8vw,8rem);display:grid;grid-template-columns:minmax(0,42fr) minmax(0,58fr);column-gap:clamp(4.5rem,8vw,8.5rem);align-items:center}.hero-copy{position:relative;z-index:2}h1{max-width:11ch;margin-bottom:1.6rem;font-size:clamp(3.65rem,6.5vw,7rem);line-height:.88;font-weight:650;letter-spacing:-.075em}h1 span{color:var(--primary)}.hero-text{max-width:570px;margin-bottom:2rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem}.hero-visual{position:relative;height:clamp(520px,65vw,760px);max-height:75vh}.hero-visual>img{width:100%;height:100%;object-fit:cover;object-position:center;border-radius:48% 48% 30px 30px;box-shadow:var(--shadow)}.hero-arch{position:absolute;inset:-22px 28px 35% -22px;border:2px solid var(--peche);border-radius:50% 50% 0 0;z-index:-1}.inline-photo{position:absolute;left:-24px;bottom:8%;width:clamp(120px,14vw,190px);aspect-ratio:1.6;padding:7px;background:var(--surface);border-radius:999px;box-shadow:var(--shadow);overflow:hidden}.inline-photo img{width:100%;height:100%;object-fit:cover;border-radius:inherit;transition:transform .7s ease}.inline-photo:hover img{transform:scale(1.05)}
@media(max-width:1000px) and (min-width:851px){.hero{grid-template-columns:minmax(0,46fr) minmax(0,54fr);column-gap:clamp(3rem,5vw,4.5rem)}h1{font-size:clamp(3.5rem,6.2vw,5rem)}}
@media(max-width:850px){.hero{min-height:auto;grid-template-columns:1fr;padding-top:9.5rem;gap:3.5rem}.hero-copy{padding-right:0}h1{max-width:12ch;font-size:clamp(3.6rem,12vw,6.2rem)}.hero-visual{height:min(108vw,680px);max-height:none}.inline-photo{left:12px}}
@media(max-width:480px){h1{font-size:clamp(3.25rem,16vw,4.7rem)}.hero-actions{flex-direction:column}.hero-actions .button{width:100%}.hero-visual{height:118vw}.hero-visual>img{border-radius:42% 42% 24px 24px}}
</style>
