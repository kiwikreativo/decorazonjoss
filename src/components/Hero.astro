---
import heroImage from "../assets/colorful-party-balloons-and-decorations-celebratio.webp";
---

<div class="container-hero">
    <div class="row">
        <div class="col-6">
            <h1 class="title">Haz cada celebración inolvidable</h1>
            <p class="hero-text">
                Transforma tus momentos especiales en recuerdos mágicos con
                nuestros servicios de decoracion para eventos. Desde reuniones
                íntimas hasta celebraciones grandiosas, traemos tu visión a
                vida.
            </p>
            <div class="btn-group gap-3">
                <button type="button" class="reserva"
                    >Reserva <i
                        class="fa-solid fa-arrow-right ms-3"
                        style="font-size: 0.9rem;"></i></button
                >
                <button type="button" class="btn-decoraciones"
                    >Ver decoraciones</button
                >
            </div>
        </div>
        <div class="col-6 relative-container">
            <div class="image-wrapper">
                <img
                    class="w-100 object-cover figure"
                    src={heroImage.src}
                    alt="Colorful party balloons and decorations"
                />
                <div class="badge">
                    <span class="badge-number">500+</span>
                    <span class="badge-text">Happy Celebrations</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Antonio:wght@100..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
    .container-hero {
        margin: 5% auto;
        width: 95%;
    }
    .row {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .title {
        font-family: "Antonio", sans-serif !important;
        font-size: 4rem;
        line-height: 1;
        font-weight: bold;
        margin-bottom: 2rem;
        background: #fb6f92;
        background: linear-gradient(
            90deg,
            rgba(251, 111, 146, 1) 0%,
            rgba(255, 179, 198, 1) 50%,
            rgba(255, 143, 171, 1) 100%
        );
        background-clip: text; /* Recorta el fondo a la forma del texto */
        -webkit-background-clip: text; /* Para navegadores WebKit (Chrome, Safari) */
        color: transparent;
    }
    .figure {
        border-radius: 10px;
        display: block; /* Removes bottom space */
    }
    .relative-container {
        position: relative;
    }
    .image-wrapper {
        position: relative;
        display: inline-block; /* Fits the content */
        width: 100%;
    }
    .badge {
        position: absolute;
        bottom: 30px;
        left: -50px;
        background-color: #dfae1d; /* Mustard yellow color */
        padding: 20px 30px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        z-index: 10;
        min-width: 200px;
    }
    .badge-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1a1a1a;
        line-height: 1;
        margin-bottom: 5px;
    }
    .badge-text {
        font-size: 1rem;
        color: #333;
        font-weight: 500;
    }

    .reserva {
        border: none;
        border-radius: 15px;
        padding: 5px 20px;
        background-color: #fb6f92;
        color: white;
    }
    .btn-group {
        margin: 1rem auto;
    }

    .btn-decoraciones {
        background-color: transparent;
        color: #080808;
        border: 1px solid #d5d5d5;
        border-radius: 10px;
        padding: 5px 15px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .btn-decoraciones:hover {
        background-color: #a2d2ff;
        color: #caf0f8;
        border-color: #a2d2ff;
    }

    @media (max-width: 700px) {
        .container {
            margin: 0 auto;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .row {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
        }
        .col-6 {
            width: 100%;
            padding: 0 0.7rem;
            text-align: center;
        }
        .title {
            font-size: 2.5rem;
            font-weight: bold;
            line-height: 1.2;
            text-align: left;
            margin: 1rem 4%;
        }
        .hero-text {
            font-size: 1rem;
            line-height: 1.5;
            text-align: left;
            margin: 1rem 4%;
        }
        .figure {
            margin: 1rem 3%;
        }
        .badge {
            bottom: -10px;
            width: fit-content;
            left: -10px;
            height: 70px;
            padding: 10px;
            margin: 1rem 3%;
        }
        .badge-number {
            font-size: 2rem;
        }
        .badge-text {
            font-size: 1rem;
            font-weight: 600;
        }
        .btn-group {
            margin: 1rem 3%;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }
        .btn-decoraciones {
            width: 100%;
            padding: 10px 20px;
            border-radius: 15px;
            font-size: 1rem;
        }
        .reserva {
            width: 100%;
            padding: 10px 20px;
            font-size: 1rem;
            border-radius: 15px;
        }
    }

    @media (min-width: 701px) and (max-width: 1024px) {
        .container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 100%;
        }
        .row {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 100%;
        }
        .col-6 {
            width: 100%;
            padding: 0 0.7rem;
            margin-left: 12px;
        }

        .title {
            font-size: 2rem;
            font-weight: bold;
            line-height: 1;
        }
        .hero-text {
            font-size: 1rem;
            line-height: 1.5;
        }

        .badge-number {
            font-size: 2rem;
        }
        .badge-text {
            font-size: 1rem;
            font-weight: 600;
        }
        .btn-group {
            display: flex;
            align-items: start;
            justify-content: start;
            margin-bottom: 5%;
            margin-top: 5%;
        }
        .btn-decoraciones {
            padding: 5px 15px;
            border-radius: 15px;
            font-size: 1rem;
        }
        .reserva {
            padding: 6px 15px;
            border-radius: 15px;
            font-size: 1rem;
        }
        .badge {
            position: absolute;
            bottom: -2px;
            left: -15px;
            padding: 10px 20px;
        }
    }
</style>
