            margin-left: 20px;
            margin-top: 20px;
        }
        .cards {
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }
        .dynamic-btn {
            margin: 2% 69% 2% 4%;
            width: fit-content;
            display: inline-block;
        }
    } */
</style>
