---
import { Baby, Balloon, Cake, Confetti, Gift, Heart, Sparkle, TreeEvergreen } from "@phosphor-icons/react";
const services=[
{icon:Baby,accent:"nectarine",title:"Revelaciones de Género",description:"Crea anticipación con impresionantes montajes de revelación de género que incluyen globos, pancartas y decoraciones temáticas."},
{icon:Gift,accent:"menthe",title:"Baby Showers",description:"Celebra nuevos comienzos con adorables decoraciones para baby showers en tonos pastel suaves y temas encantadores."},
{icon:Cake,accent:"peche",title:"Cumpleaños",description:"Desde primeros cumpleaños hasta celebraciones de hitos, creamos ambientes de fiesta mágicos y apropiados para cada edad."},
{icon:Heart,accent:"lagune",title:"Bodas",description:"Decoraciones de boda elegantes y románticas adaptadas a tu historia de amor y estilo únicos."},
{icon:TreeEvergreen,accent:"warm",title:"Fiestas de Navidad",description:"Decoraciones festivas que capturan la calidez y la alegría de la temporada navideña."},
{icon:Confetti,accent:"cool",title:"Eventos Especiales",description:"Decoraciones personalizadas para aniversarios, graduaciones, eventos corporativos y cualquier celebración que imagines."}];
---
<section class="services section-pad" id="services"><div class="section-shell"><div class="section-intro"><p class="eyebrow">Tu ocasión, hecha a tu medida</p><h2 class="display-title">Celebraciones que decoramos</h2><p>Cualquiera que sea la ocasión, transformaremos tu espacio en una obra maestra de celebración.</p></div><div class="service-grid">{services.map((service,index)=><article class={`service-card ${service.accent}`}><div class="icon-row"><span><service.icon size={25} weight="duotone"/></span><span class="mini-icon">{index%2===0?<Sparkle size={18} weight="fill"/>:<Balloon size={18} weight="duotone"/>}</span></div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></div></section>
<style>
.services{background:color-mix(in srgb,var(--primary) 14%,var(--background))}.section-intro{max-width:760px;margin-bottom:3.5rem}.section-intro>p:last-child{max-width:620px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-flow:dense;gap:14px}.service-card{min-height:310px;padding:clamp(1.5rem,3vw,2.25rem);display:flex;flex-direction:column;justify-content:flex-end;border:1px solid rgba(37,36,35,.1);border-radius:30px;overflow:hidden;transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease}.service-card:hover{transform:translateY(-5px);border-color:rgba(37,36,35,.25);box-shadow:0 18px 34px rgba(64,43,37,.08)}.icon-row{margin-bottom:auto;display:flex;justify-content:space-between}.icon-row span{width:48px;height:48px;display:grid;place-items:center;color:#2d2926;background:rgba(255,255,255,.65);border:1px solid rgba(255,255,255,.5);border-radius:14px;transition:transform .3s}.service-card:hover .icon-row span:first-child{transform:rotate(-6deg) scale(1.05)}.icon-row .mini-icon{width:36px;height:36px}.service-card h3{margin:2rem 0 .75rem;color:#252423;font-size:clamp(1.55rem,2.3vw,2.15rem);line-height:1}.service-card p{margin:0;color:#4e4945;font-size:.96rem;line-height:1.55}.nectarine{background:#e9afa7}.menthe{background:#b7dacb}.peche{background:#f8cb87}.lagune{background:#9fc4cf}.warm{background:linear-gradient(135deg,#ead0bb,#efb59b)}.cool{background:linear-gradient(135deg,#b5d8ca,#9ebfc8)}
@media(max-width:900px){.service-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.service-grid{grid-template-columns:1fr}.service-card{min-height:275px}}
</style>
