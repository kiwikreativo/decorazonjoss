---
import { HandHeart, MagicWand, Palette, Sparkle } from "@phosphor-icons/react";
const reasons=[{icon:HandHeart,title:"Atención personalizada",text:"Escuchamos tu idea y cuidamos cada decisión junto a ti."},{icon:Palette,title:"Diseños para cada ocasión",text:"Adaptamos colores, formas y detalles al espíritu de tu evento."},{icon:MagicWand,title:"Creatividad y detalle",text:"Convertimos cada espacio en un ambiente mágico y único."},{icon:Sparkle,title:"Experiencia cercana",text:"Desde 2015 creamos celebraciones con calidad, calidez y confianza."}];
---
<section class="why section-pad"><div class="section-shell"><p class="eyebrow">Por qué elegirnos</p><h2 class="display-title">Detalles que hacen especial cada celebración</h2><div class="reason-grid">{reasons.map(reason=><article><reason.icon size={42} weight="duotone"/><h3>{reason.title}</h3><p>{reason.text}</p></article>)}</div></div></section>
<style>.why{background:var(--surface)}.why .display-title{max-width:850px}.reason-grid{margin-top:4rem;display:grid;grid-template-columns:repeat(4,1fr)}.reason-grid article{padding:0 clamp(1.25rem,2.5vw,2.5rem);border-left:1px solid var(--border)}.reason-grid article:first-child{padding-left:0;border-left:0}.reason-grid svg{margin-bottom:2rem;color:var(--primary)}.reason-grid article:nth-child(2) svg{color:var(--peche)}.reason-grid article:nth-child(3) svg{color:var(--menthe)}.reason-grid article:nth-child(4) svg{color:var(--lagune)}.reason-grid h3{font-size:1.3rem}.reason-grid p{font-size:.96rem}@media(max-width:850px){.reason-grid{grid-template-columns:repeat(2,1fr);gap:3rem 0}.reason-grid article:nth-child(3){padding-left:0;border-left:0}}@media(max-width:540px){.reason-grid{grid-template-columns:1fr}.reason-grid article{padding:0 0 2rem;border-left:0;border-bottom:1px solid var(--border)}}</style>
