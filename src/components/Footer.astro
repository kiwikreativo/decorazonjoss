---
import "./../styles/footer.css";
import { FacebookLogo, InstagramLogo, HeartIcon } from "@phosphor-icons/react";
const actualYear = new Date().getFullYear();

import { socialLinks } from "../lib/socialLinks";
---


<footer class="footer">
    <div class="footer-container">
        <div class="footer-content">
            <!-- Brand Section -->
            <div class="footer-brand">
                <div class="brand-logo">
                    <HeartIcon
                        size={22}
                        weight="fill"
                        className="icon-footer"
                    />
                    <span class="brand-name">Decorazon Joss</span>
                </div>
                <p class="brand-tagline">
                    Creando momentos mágicos y celebraciones inolvidables desde
                    2015.
                </p>
            </div>

            <!-- Services Section -->
            <div class="footer-section">
                <h3 class="footer-heading">Servicios</h3>
                <ul class="footer-links">
                    <li>
                        <a href="#">Revelación de género</a>
                    </li>
                    <li><a href="#">Baby Showers</a></li>
                    <li><a href="#">Fiestas de cumpleaños</a></li>
                    <li><a href="#">Bodas</a></li>
                </ul>
            </div>

            <!-- Company Section -->
            <div class="footer-section">
                <h3 class="footer-heading">Compañía</h3>
                <ul class="footer-links">
                    <li><a href="/Portfolio">Portafolio</a></li>
                    <li><a href="/#contact">Contacto</a></li>
                    <li><a href="/#about">Sobre Nosotros</a></li>
                </ul>
            </div>

            <!-- Social Section -->
            <div class="footer-section">
                <h3 class="footer-heading">Síguenos</h3>
                <div class="social-links">
                    <a
                        href={socialLinks.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram de Decorazon Joss"
                        class="icon"
                    >
                        <InstagramLogo size={21} weight="regular" />
                    </a>
                    <!-- <a
                        href="https://facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook de Decorazon Joss"
                        class="icon"
                    >
                        <FacebookLogo size={21} weight="regular" />
                    </a> -->
                </div>
            </div>
        </div>

        <!-- Copyright Section -->
        <div class="footer-bottom">
            <p class="copyright">
                &copy; <span id="current-year">{actualYear}</span> Decorazon Joss. Todos los derechos
                reservados.
            </p>
        </div>
    </div>
</footer>
