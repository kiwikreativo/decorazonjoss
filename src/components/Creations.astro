---
import Moya from "../assets/17.webp";import navidad from "../assets/11.webp";import quinceanios from "../assets/12.webp";import party from "../assets/13.webp";import marineparty from "../assets/14.webp";import EmmaParty from "../assets/15.webp";import { ArrowRight } from "@phosphor-icons/react";
const creations=[{img:Moya,alt:"Celebración de cumpleaños con temática vaquera"},{img:quinceanios,alt:"Decoración de quince años"},{img:navidad,alt:"Decoración navideña colorida"},{img:party,alt:"Decoración elegante para matrimonio"},{img:marineparty,alt:"Cumpleaños con temática marina"},{img:EmmaParty,alt:"Cumpleaños infantil en rosa y rojo"}];
---
<section class="creations section-pad" id="creations"><div class="section-shell creation-head"><div><p class="eyebrow">Momentos hechos con intención</p><h2 class="display-title">Decoraciones Realizadas</h2></div><p>Aquí te muestro algunas de las decoraciones que hemos realizado para diferentes ocasiones.</p></div><div class="catalogue" role="list" aria-label="Selección de decoraciones realizadas">{creations.map((creation,index)=><figure class:list={["catalogue-panel",{"is-active":index===0}]} role="listitem" tabindex="0"><img src={creation.img.src} alt={creation.alt} loading={index>1?"lazy":"eager"}/><div class="panel-shade"></div><figcaption>{creation.alt}</figcaption></figure>)}</div><div class="catalogue-action section-shell"><a class="button button-primary" href="/Portfolio">Ver más decoraciones <ArrowRight size={18}/></a></div></section>
<style>
.creations{background:var(--background)}.creation-head{display:grid;grid-template-columns:1.4fr .6fr;gap:3rem;align-items:end;margin-bottom:3.5rem}.creation-head .display-title{margin-bottom:0}.creation-head>p{max-width:440px}.catalogue{width:min(calc(100% - 40px),1440px);height:clamp(500px,62vw,720px);margin-inline:auto;display:flex;gap:10px;overflow:hidden}.catalogue-panel{position:relative;flex:1 1 0;margin:0;min-width:0;overflow:hidden;border-radius:26px;cursor:pointer;isolation:isolate;transition:flex-grow .7s cubic-bezier(.22,.75,.18,1),filter .4s ease}.catalogue-panel.is-active,.catalogue-panel:hover,.catalogue-panel:focus-visible{flex-grow:5.2}.catalogue-panel:not(.is-active):not(:hover){filter:saturate(.72)}.catalogue-panel img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.22,.75,.18,1)}.catalogue-panel:hover img,.catalogue-panel.is-active img{transform:scale(1.025)}.panel-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(13,16,17,.72));z-index:1}.catalogue-panel figcaption{position:absolute;z-index:2;left:clamp(1rem,2vw,2rem);right:clamp(1rem,2vw,2rem);bottom:clamp(1rem,2vw,2rem);color:#fff;font-size:clamp(1.1rem,2vw,1.65rem);font-weight:600;line-height:1.1;opacity:0;transform:translateY(12px);transition:opacity .35s ease .18s,transform .35s ease .18s}.catalogue-panel.is-active figcaption,.catalogue-panel:hover figcaption,.catalogue-panel:focus-visible figcaption{opacity:1;transform:none}.catalogue-action{display:flex;justify-content:center;margin-top:2.5rem}
@media(max-width:850px){.creation-head{grid-template-columns:1fr}.catalogue{height:520px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}.catalogue-panel,.catalogue-panel.is-active,.catalogue-panel:hover,.catalogue-panel:focus-visible{flex:0 0 min(78vw,480px);scroll-snap-align:center}.catalogue-panel figcaption{opacity:1;transform:none}}
@media(max-width:540px){.catalogue{width:calc(100% - 32px);height:470px;gap:8px}.catalogue-panel,.catalogue-panel.is-active,.catalogue-panel:hover,.catalogue-panel:focus-visible{flex-basis:86vw}.catalogue-action .button{width:100%}}
</style>
<script>
const panels=document.querySelectorAll<HTMLElement>('.catalogue-panel');const activate=(panel:HTMLElement)=>panels.forEach(item=>item.classList.toggle('is-active',item===panel));panels.forEach(panel=>{panel.addEventListener('click',()=>activate(panel));panel.addEventListener('focus',()=>activate(panel));panel.addEventListener('mouseenter',()=>activate(panel));panel.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();activate(panel)}})});
</script>
