---
import { Gift, Cake, Heart, TreePine, PartyPopper } from "lucide-react";
import beachWeddingImg from "../assets/beach-themed-wedding-decorations.webp";
import babyShowersImg from "../assets/pastel-baby-shower-decorations-with-teddy-bears.webp";
import genderRevealImg from "../assets/blue-and-gold-gender-reveal-party.webp";
import genderRevealImg2 from "../assets/pink-and-blue-gender-reveal-party-balloons.webp";
import silverAndWhiteImg from "../assets/silver-and-white-christmas-party-modern.webp";
import redAndGreenImg from "../assets/red-and-green-christmas-party-decorations.webp";
import "../styles/globals.css";

interface Creations {
    img: any;
}

let creations: Creations[] = [
    {
        img: beachWeddingImg,
    },
    {
        img: genderRevealImg,
    },
    {
        img: babyShowersImg,
    },
    {
        img: genderRevealImg2,
    },
    {
        img: silverAndWhiteImg,
    },
    {
        img: redAndGreenImg,
    },
];
---

<!-- /home/guglielmo/Documents/proyects/decorazonjoss/src/assets/beach-themed-wedding-decorations.webp -->
<div class="container-creations" id="creations">
    <div class="greeting">
        <h1 class="greeting-h1 mt-4">Decoraciones Realizadas</h1>
        <p class="greeting-p">
            Aquí te muestro algunas de las decoraciones que hemos realizado para
            diferentes ocasiones.
        </p>
    </div>
    <div
        class="cards d-flex flex-direction-column justify-content-center align-items-center"
    >
        {
            creations.map((creation) => (
                <div class="gallery">
                    <div class="gallery-item">
                        <img
                            src={creation.img.src}
                            alt=""
                            class="gallery-image"
                        />
                    </div>
                </div>
            ))
        }
    </div>
    <button onclick="window.location.href='/Portfolio'" class="btn-decoraciones"
        >Ver mas decoraciones</button
    >
</div>
<style>
    @import url("https://fonts.googleapis.com/css2?family=Antonio:wght@100..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
    .container-creations {
        margin: 5% auto;
        width: 100%;
        height: fit-content;
        padding-bottom: 3%;
    }
    .greeting {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        line-height: 0.5;
        justify-content: center;
        line-height: 2;
    }

    .greeting-h1 {
        font-size: 3rem;
        font-weight: 900;
        font-family: "Antonio", sans-serif;
        color: black;
    }

    .greeting-p {
        margin-left: 3.5%;
        margin-bottom: 2%;
    }

    .cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 20px;
        gap: 20px;
    }

    .gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .gallery-item {
        width: 500px;
        gap: 10px;
    }

    .gallery-image {
        width: 500px;
        height: 500px;
        object-fit: cover;
        border-radius: 10px;
    }

    .gallery-image:hover {
        transform: scale(1.05); /* Zoom in by 5% */
        transition: transform 0.3s ease-in-out;
        opacity: 0.7;
    }

    .btn-decoraciones {
        display: block;
        margin: 2% auto;
        padding: 5px 20px;
        background-color: #dd2d4a;
        color: white;
        border: none;
        border-radius: 10px;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .greeting-p {
            font-size: 1rem;
            line-height: 1;
            margin-right: 10px;
        }

        .cards {
            margin-left: 1%;
        }

        .gallery {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-left: 0;
        }

        .gallery-item {
            width: 350px;
            gap: 10px;
        }

        .gallery-image {
            width: 350px;
            height: 350px;
            object-fit: cover;
            border-radius: 10px;
        }
        .btn-decoraciones {
            margin-top: 5%;
        }
    }
    @media (max-width: 1078px) {
        .greeting-p {
            line-height: 1.2;
        }
        .gallery {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-left: 0;
        }

        .gallery-item {
            width: 400px;
            gap: 10px;
        }

        .gallery-image {
            width: 400px;
            height: 400px;
            object-fit: cover;
            border-radius: 10px;
        }
        .btn-decoraciones {
            margin-top: 5%;
        }
    }
</style>
