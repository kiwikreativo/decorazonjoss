---
import { Gift, Cake, Heart, TreePine, PartyPopper } from "lucide-react";
import Moya from "../assets/17.webp";
import navidad from "../assets/11.webp";
import quinceanios from "../assets/12.webp";
import party from "../assets/13.webp";
import marineparty from "../assets/14.webp";
import EmmaParty from "../assets/15.webp";
import "../styles/globals.css";

interface Creations {
    img: any;
}

let creations: Creations[] = [
    {
        img: Moya,
    },
    {
        img: quinceanios,
    },
    {
        img: navidad,
    },
    {
        img: party,
    },
    {
        img: marineparty,
    },
    {
        img: EmmaParty,
    },
];
---

<!-- /home/guglielmo/Documents/proyects/decorazonjoss/src/assets/beach-themed-wedding-decorations.webp -->
<div class="container-creations" id="creations">
    <div class="greeting">
        <h1 class="greeting-h1 mt-4">Decoraciones Realizadas</h1>
        <p class="greeting-p">
            Aquí te muestro algunas de las decoraciones que hemos realizado para
            diferentes ocasiones.
        </p>
    </div>
    <div class="cards">
        {
            creations.map((creation) => (
                <div class="gallery">
                    <div class="gallery-item">
                        <img
                            src={creation.img.src}
                            alt=""
                            class="gallery-image"
                        />
                    </div>
                </div>
            ))
        }
    </div>
    <button onclick="window.location.href='/Portfolio'" class="btn-decoraciones"
        >Ver mas decoraciones</button
    >
</div>
<style>
    @import url("https://fonts.googleapis.com/css2?family=Antonio:wght@100..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
    .container-creations {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        text-align: left;
        padding: 0;
        margin: 5% auto;
    }

    .greeting {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        justify-content: center;
        line-height: 2;
        width: 100%;
        padding: clamp(1rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem) 0 clamp(1rem, 5vw, 3rem);
    }

    .greeting-h1 {
        font-size: 3rem;
        font-weight: 900;
        font-family: "Antonio", sans-serif;
        color: black;
    }

    .greeting-p {
        margin-left: 0;
        margin-bottom: 2%;
        line-height: 1.5;
    }

    /* cards grid layout for 3 columns on desktop */
    .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    margin-top: 20px;
    gap: 20px;
    padding: 0 clamp(1rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem);
}

    .gallery-item {
        display: flex;
        justify-content: center;
    }

    .gallery-image {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 10px;
        transition: transform 0.3s ease-in-out, opacity 0.3s;
    }

    .gallery-image:hover {
        transform: scale(1.05); /* Zoom in by 5% */
        transition: transform 0.3s ease-in-out;
        opacity: 0.7;
    }

    @import url("https://fonts.googleapis.com/css2?family=Henny+Penny&family=Rubik+Spray+Paint&display=swap");
    .btn-decoraciones {
        display: block;
        margin: 5% auto;
        padding: 20px 20px;
        font-family: "Henny Penny", system-ui;
        font-size: 1.2rem;
        font-weight: 700;
        text-transform: uppercase;
        background-color: #dd2d4a;
        color: white;
        border: none;
        border-radius: 10px;
        cursor: pointer;
    }
    

    /* responsive tweaks */
    @media (max-width: 900px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .greeting-h1 {
        font-size: 2rem;
    }
    .cards {
        grid-template-columns: 1fr;
    }
}
</style>
