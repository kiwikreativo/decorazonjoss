---

---

<div class="contact-container" id="contact">
    <div class="salute">
        <h1 class="salute-title">Planeemos tu celebración al detalle</h1>
        <p class="salute-text">
            Listos para crear memorias inolvidables? Agenda tu cita y empecemos
            a planear
        </p>
    </div>
    <div class="contact">
        <div class="row" style="display: flex; justify-content: space between;">
            <div class="col-6 s-appointment">
                <h3 class="appointment-text">Agenda tu Cita</h3>
                <a href="" class="btn-redirect-calendly">Agendar!</a>
            </div>
            <div class="col-6 container-contact">
                <!-- Phone -->
                <div class="contact-item">
                    <div class="icon-circle">
                        <svg class="icon" viewBox="0 0 24 24">
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path>
                        </svg>
                    </div>
                    <div class="contact-text">
                        <div class="contact-label">Télefono</div>
                        <div class="contact-value">8796-4508</div>
                    </div>
                </div>

                <!-- Email -->
                <div class="contact-item">
                    <div class="icon-circle">
                        <svg class="icon" viewBox="0 0 24 24">
                            <path
                                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                            ></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <div class="contact-text">
                        <div class="contact-label">Correo</div>
                        <div class="contact-value">jocysegura@hotmail.com</div>
                    </div>
                </div>

                <!-- Location -->
                <div class="contact-item">
                    <div class="icon-circle">
                        <svg class="icon" viewBox="0 0 24 24">
                            <path
                                d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                            ></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div class="contact-text">
                        <div class="contact-label">Ubicación</div>
                        <div class="contact-value">Alajuela, Costa Rica</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");

    .contact-container {
        margin: 0 auto;
        padding: 100px 0;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .container {
        padding: 40px;
        max-width: 2000px;
        margin: 0 auto;
    }

    .container-contact {
        display: flex;
        margin-top: 5%;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 30px;
    }

    .row {
        /* margin-left: 0%; */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .s-appointment {
        margin: 2%;
    }

    .appointment-text {
        text-transform: uppercase;
        font-weight: 800;
    }

    .btn-redirect-calendly {
        background-color: #ffafcc;
        color: white;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        margin-top: 20px;
    }

    .salute-title {
        font-family: "Geist", sans-serif;
        font-weight: bold;
        font-size: 3rem;
        margin-top: 0;
    }
    .salute-text {
        font-family: "Inter", sans-serif;
        font-size: 1.2rem;
        color: #b7b7b7;
    }

    /* Custom focus style with pink highlight */
    .form-control:focus,
    textarea:focus,
    input:focus {
        outline: none;
        border: none;
        border-color: #ffafcc;
        box-shadow: 0 0 0 0.25rem rgba(255, 175, 204, 0.25);
    }
    /* Style for form controls */
    .form-control {
        width: 100%;
        padding: 8px;
        margin-bottom: 15px;
        border-radius: 15px;
        font-family: "Inter", sans-serif;
        transition:
            border-color 0.15s ease-in-out,
            box-shadow 0.15s ease-in-out;
    }

    textarea.form-control {
        min-height: 120px;
        resize: none;
    }

    .submit {
        width: 100%;
        border: none;
        border-radius: 15px;
        background-color: #ffafcc;
        color: white;
        padding: 8px;
    }
    .send {
        width: 20px;
    }

    /* styling placeholder */

    /* Style for all placeholders */
    ::placeholder {
        color: #999; /* Light gray color */
        font-family: "Geist", sans-serif;
        opacity: 1;
    }

    /* For WebKit browsers (Chrome, Safari) */
    ::-webkit-input-placeholder {
        color: #999;
        font-family: "Inter", sans-serif;
    }

    /* For Firefox */
    ::-moz-placeholder {
        color: #999;
        font-family: "Inter", sans-serif;
        opacity: 1; /* Firefox adds opacity by default */
    }

    /* For Internet Explorer */
    :-ms-input-placeholder {
        color: #999;
        font-family: "Inter", sans-serif;
    }

    /* For Microsoft Edge */
    :-ms-input-placeholder {
        color: #999;
        font-family: "Inter", sans-serif;
    }

    .contact-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        background-color: #fce4ec;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-left: 5%;
    }

    .icon {
        width: 23px;
        height: 23px;
        stroke: #e91e63;
        stroke-width: 2.5;
        fill: none;
    }

    .contact-text {
        flex: 0.5;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .contact-label {
        font-size: 20px;
        font-weight: bold;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .contact-value {
        font-size: 16px;
        color: #686868;
        line-height: 1.4;
    }

    .business-hours {
        background-color: #f1f1f1;
        border-radius: 16px;
        width: 95%;
        height: 40%;
        margin-top: 5px;
        margin-left: 5%;
        margin-right: 20%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .business-hours h2 {
        font-size: 24px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .hours-item {
        font-size: 16px;
        color: #5f6368;
        margin-bottom: 12px;
        line-height: 1.6;
    }

    .hours-item:last-child {
        margin-bottom: 0;
    }

    @media (max-width: 768px) {
        .contact-container {
            display: flex;
            flex-direction: column;
            width: 90%;
            padding: 50px 0;
        }

        .row {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .col-6 {
            width: 100%;
            margin-bottom: 10%;
        }

        .container-contact {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container-form {
            border: 2px solid #f6f3f4;
            padding: 20px;
            border-radius: 15px;
            width: 300px;
            margin-right: 20px;
        }

        .contact-item {
            width: 100%;
        }

        .icon-circle {
            margin-left: 0;
        }

        .contact-text {
            flex: 1;
        }

        .contact-value {
            white-space: nowrap;
        }

        .icon-wrapper {
            position: absolute;
            left: 30%;
            color: #ffafcc;
            background-color: #f6f3f4;
            border-radius: 20px;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .business-hours {
            margin-top: 10%;
            margin-left: 10%;
            width: 300px;
            height: 150px;
        }
    }
    @media (min-width: 769px) and (max-width: 1024px) {
        .contact-container {
            display: flex;
            flex-direction: column;
            width: 90%;
        }
        .row {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .container-form {
            width: 180%;
            margin-left: -50%;
            margin-bottom: 10%;
        }

        .contact-text {
            flex: 0.5;
            display: flex;
            flex-direction: column;
            align-items: flex-start; /* ✅ Esto alinea todo a la izquierda */
            text-align: left; /* ✅ Asegura que el texto esté alineado a la izquierda */
        }

        .contact-label {
            font-size: 20px;
            font-weight: bold;
            color: #1a1a1a;
            margin-bottom: 4px;
            text-align: left; /* ✅ Añade esto */
        }

        .contact-value {
            font-size: 16px;
            color: #686868;
            line-height: 1.4;
            text-align: left; /* ✅ Añade esto */
        }

        .container-contact {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .icon-circle {
            margin-left: 0;
        }

        .business-hours {
            background-color: #f9f9f9;
            border-radius: 16px;
            width: 90%;
            margin-top: 15px;
        }

        .business-hours h2 {
            font-size: 24px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
        }

        .hours-item {
            font-size: 16px;
            color: #5f6368;
            margin-bottom: 12px;
            line-height: 1.6;
        }

        .hours-item:last-child {
            margin-bottom: 0;
        }
    }
</style>
