---
import { CalendarCheck, Envelope, MapPin, Phone } from "@phosphor-icons/react";
---
<section class="contact section-pad" id="contact"><div class="section-shell contact-panel"><p class="eyebrow">Tu próxima celebración empieza aquí</p><h2 class="display-title">Planeemos tu celebración al detalle</h2><p class="lead">¿Listos para crear memorias inolvidables? Agenda tu cita y empecemos a planear.</p><a class="button booking" href="https://calendly.com/decorazonjoss/180min" target="_blank" rel="noopener noreferrer"><CalendarCheck size={20} weight="bold"/> Agendar tu cita</a><div class="contact-list"><a href="tel:+50687964508"><Phone size={24} weight="duotone"/><span><small>Teléfono</small>8796-4508</span></a><a href="mailto:jocysegura@hotmail.com"><Envelope size={24} weight="duotone"/><span><small>Correo</small>jocysegura@hotmail.com</span></a><div><MapPin size={24} weight="duotone"/><span><small>Ubicación</small>Alajuela, Costa Rica</span></div></div></div></section>
<style>.contact{background:var(--background)}.contact-panel{padding:clamp(3rem,7vw,7rem);text-align:center;background:var(--lagune);border-radius:var(--radius-lg);overflow:hidden;position:relative}.contact-panel:before,.contact-panel:after{content:"";position:absolute;width:240px;height:240px;border:50px solid rgba(255,255,255,.12);border-radius:50%}.contact-panel:before{left:-100px;top:-110px}.contact-panel:after{right:-110px;bottom:-130px}.contact-panel>*{position:relative;z-index:1}.contact .eyebrow,.contact .lead{color:#18303a}.contact .display-title{max-width:900px;margin-inline:auto;color:#13262d}.lead{max-width:600px;margin:0 auto 2rem}.booking{background:#f7eee6;color:#1f2728}.contact-list{margin-top:4rem;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(20,42,49,.25)}.contact-list>a,.contact-list>div{min-width:0;padding:2rem 1rem 0;display:flex;align-items:center;justify-content:center;gap:.8rem;color:#13262d;text-align:left;text-decoration:none}.contact-list>*+*{border-left:1px solid rgba(20,42,49,.25)}.contact-list span{min-width:0;overflow-wrap:anywhere;font-weight:600}.contact-list small{display:block;margin-bottom:.25rem;font-size:.72rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase}@media(max-width:760px){.contact-list{grid-template-columns:1fr}.contact-list>a,.contact-list>div{justify-content:flex-start;padding:1.25rem 0}.contact-list>*+*{border-left:0;border-top:1px solid rgba(20,42,49,.25)}}
</style>
